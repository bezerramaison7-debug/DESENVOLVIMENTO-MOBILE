<resources>
    <style name="LabTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#155E59</item>
        <item name="android:statusBarColor">#103835</item>
        <item name="android:navigationBarColor">#103835</item>
        <item name="android:windowBackground">#F4F8F7</item>
    </style>
    <style name="Heading">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#103835</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="Action" parent="android:style/Widget.Material.Light.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
